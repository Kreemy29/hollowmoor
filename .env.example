# ===========================================================================
# HOLLOWMOOR — environment
#
# Copy to `.env.local` and fill in what you need.
#
# NOTHING HERE IS REQUIRED TO PLAY. With an empty file the game runs entirely
# in the browser against localStorage: full single-player loop, all four
# minigames, the Codex, trials, quests, shop, and the local voice library. The
# multiplayer screens are populated by clearly-labelled "Echo Breakers".
#
# Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Secrets go in Supabase, never here — see the bottom of this file.
# ===========================================================================

# --- Going online (friends, chat, presence, raids, cross-device saves) ------
# From your Supabase project: Settings → API.
# The anon key is safe to ship: every table is protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Push reminders (optional) ---------------------------------------------
# Generate a VAPID key pair:  npx web-push generate-vapid-keys
# Only the PUBLIC half goes here. The private half is a Supabase secret.
VITE_VAPID_PUBLIC_KEY=

# --- Chat moderation (optional) --------------------------------------------
# Comma-separated terms to block outright, on top of the built-in rules.
# Point this at a maintained slur list before inviting anyone beyond friends.
VITE_BLOCKLIST=


# ===========================================================================
# SERVER-SIDE SECRETS — these do NOT go in this file.
#
# Set them on Supabase so they never reach a browser:
#
#   supabase secrets set XAI_API_KEY=xai-...
#   supabase secrets set XAI_MODEL=grok-3
#   supabase secrets set VAPID_PUBLIC_KEY=...
#   supabase secrets set VAPID_PRIVATE_KEY=...
#   supabase secrets set VAPID_SUBJECT=mailto:you@example.com
#   supabase secrets set CRON_SECRET=<long random string>
#
# XAI_API_KEY is read ONLY by supabase/functions/grok-generate. If you ever
# find yourself typing VITE_XAI_API_KEY, stop — that publishes your key to
# everyone who opens the app.
# ===========================================================================
